<Application x:Class="ADOps.GpoManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ADOps.GpoManager.App.ViewModels"
             xmlns:views="clr-namespace:ADOps.GpoManager.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Association ViewModel -> Vue : la navigation se fait sans code-behind métier. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GpoAssistantViewModel}">
                <views:GpoAssistantView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParcViewModel}">
                <views:ParcView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClientAccountsViewModel}">
                <views:ClientAccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DirectoryViewModel}">
                <views:DirectoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComputerDetailViewModel}">
                <views:ComputerDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DepartmentMappingViewModel}">
                <views:DepartmentMappingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GpoListViewModel}">
                <views:GpoListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
                <views:CatalogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeploymentsViewModel}">
                <views:DeploymentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditViewModel}">
                <views:AuditView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AutomateGpoViewModel}">
                <views:AutomateGpoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
