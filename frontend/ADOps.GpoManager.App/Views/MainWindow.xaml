<Window x:Class="ADOps.GpoManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ADOps.GpoManager.App.Controls"
        xmlns:views="clr-namespace:ADOps.GpoManager.App.Views"
        Title="ADOps GPO Manager — Mode réel"
        FontFamily="{StaticResource AppFontFamily}"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Modèle unique de bouton de navigation : icône Lucide, titre, compteur.
             Le gabarit est partagé par les quatre groupes de la barre latérale. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource DemoNavButtonStyle}"
                    Margin="0,1"
                    ToolTip="{Binding Title}"
                    AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Key}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:LucideIcon Grid.Column="0" Icon="{Binding Icon}"
                                         Style="{StaticResource NavIconElementStyle}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                               Margin="10,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Border Grid.Column="2" Style="{StaticResource DemoNavCountStyle}"
                            Visibility="{Binding ShowCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Count}" Style="{StaticResource DemoNavCountTextStyle}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="NavGroupStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource NavItemTemplate}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Liseré supérieur : dégradé discret, accent -> turquoise -> émeraude -->
        <Border Grid.Row="0" Background="{StaticResource TopLineBrush}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" MinWidth="266" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= BARRE LATÉRALE ================= -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="20,18,20,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="11" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentBorderBrush}" Background="{DynamicResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <controls:LucideIcon Icon="ShieldCheck" Width="19" Height="19"
                                                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                <TextBlock Text="ADOps GPO Manager" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Pilote GPO · AD DS" Style="{StaticResource CaptionStyle}" FontSize="10.5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="13,4,13,10">
                        <StackPanel>
                            <TextBlock Text="PILOTAGE" Style="{StaticResource NavGroupLabelStyle}" />
                            <ItemsControl ItemsSource="{Binding SupervisionNavigation}" Style="{StaticResource NavGroupStyle}" />

                            <TextBlock Text="CIBLAGE ET APPLICATION DES GPO" Style="{StaticResource NavGroupLabelStyle}"
                                       TextWrapping="Wrap" Margin="12,18,10,6" />
                            <ItemsControl ItemsSource="{Binding PrimaryNavigation}" Style="{StaticResource NavGroupStyle}" />

                            <TextBlock Text="VÉRIFICATION ET TRAÇABILITÉ" Style="{StaticResource NavGroupLabelStyle}"
                                       TextWrapping="Wrap" Margin="12,18,10,6" />
                            <ItemsControl ItemsSource="{Binding VerificationNavigation}" Style="{StaticResource NavGroupStyle}" />

                            <TextBlock Text="APPLICATION" Style="{StaticResource NavGroupLabelStyle}" Margin="12,18,0,6" />
                            <ItemsControl ItemsSource="{Binding ApplicationNavigation}" Style="{StaticResource NavGroupStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Carte de session réelle -->
                    <Border Grid.Row="2" Margin="13,0,13,13" Padding="13" CornerRadius="12"
                            Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Icon="KeyRound" Width="13" Height="13"
                                                     Stroke="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="SESSION RÉELLE" Style="{StaticResource FieldLabelStyle}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Connection.Current.DomainFqdn}" FontWeight="SemiBold" FontSize="12.5"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Connection.IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Non connecté" FontWeight="SemiBold" FontSize="12.5" Margin="0,5,0,0"
                                       Visibility="{Binding Connection.IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <controls:LucideIcon Icon="Circle" Width="8" Height="8"
                                                     Stroke="{DynamicResource SuccessBrush}" StrokeThickness="3" />
                                <TextBlock Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="6,0,0,0"
                                           Text="Aucun mot de passe stocké" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionStyle}" FontSize="10.5" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="{Binding Connection.Current.ServerFqdn, StringFormat='DC : {0}', TargetNullValue='DC : —', FallbackValue='DC : —'}" />
                            <TextBlock Style="{StaticResource CaptionStyle}" FontSize="10.5" TextWrapping="Wrap"
                                       Text="{Binding CurrentUserShort, StringFormat='Compte : {0}', TargetNullValue='Compte : —'}" />
                            <TextBlock x:Name="SessionLockStatus" Text="Session : —" Style="{StaticResource CaptionStyle}"
                                       FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LastSyncText}" Style="{StaticResource CaptionStyle}"
                                           FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="OnLockSessionClick"
                                        Style="{StaticResource DemoSmallButtonStyle}" Margin="6,0,0,0"
                                        ToolTip="Verrouiller la session" AutomationProperties.Name="Verrouiller la session">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LucideIcon Icon="Lock" Width="12" Height="12" />
                                        <TextBlock Text="Verrouiller" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= ZONE PRINCIPALE ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barre d'outils -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="20,8" MinHeight="58">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="20" Padding="14,7" MaxWidth="300"
                                    HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:LucideIcon Grid.Column="0" Icon="Search" Width="13" Height="13"
                                                         Stroke="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                    <Grid Grid.Column="1">
                                        <TextBox Text="{Binding Workspace.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" MinHeight="22" Padding="0"
                                                 FontFamily="{StaticResource AppFontFamily}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Rechercher une GPO ou un poste dans le flux" />
                                        <TextBlock Text="Rechercher une GPO, un poste…" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Workspace.SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                                <TextBlock Text="{Binding SyncStatusText}" Style="{StaticResource CaptionStyle}" FontSize="10.5"
                                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SyncStatusText, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                                <TextBlock Text="{Binding SessionWarningsText}" Foreground="{DynamicResource WarningBrush}"
                                           FontSize="10.5" Margin="10,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SessionWarningsText, Converter={StaticResource EmptyStringToCollapsedConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="9,4" Margin="0,0,8,0" Background="{DynamicResource WarningSoftBrush}"
                                    ToolTip="Mode réel : AD DS, GPMC et WinRM — aucune donnée simulée.">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Icon="TriangleAlert" Width="12" Height="12"
                                                         Stroke="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="MODE RÉEL" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource DemoSmallButtonStyle}" Margin="0,0,8,0"
                                    Command="{Binding SyncNowCommand}"
                                    ToolTip="Relancer la collecte AD DS (GPO, OU, postes, comptes)"
                                    AutomationProperties.Name="Resynchroniser">
                                <StackPanel Orientation="Horizontal">
                                    <controls:LucideIcon Icon="RefreshCw" Width="13" Height="13" />
                                    <TextBlock Text="Resynchroniser" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="20" Padding="4,4,10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{Binding CurrentUserInitial}" Foreground="White" FontWeight="Bold"
                                                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUserShort}" FontSize="11.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="92" />
                                        <TextBlock Text="{Binding UserDomainText}" Style="{StaticResource CaptionStyle}" FontSize="9.5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenu : tableau de bord, flux (4 étapes + console), audit, paramètres -->
                <Grid Grid.Row="1">
                    <Grid Visibility="{Binding IsOverviewSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:DashboardView DataContext="{Binding Dashboard}" />
                    </Grid>
                    <Grid Visibility="{Binding IsWorkspaceSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:WorkspaceView DataContext="{Binding Workspace}" />
                    </Grid>
                    <Grid Visibility="{Binding IsAuditSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:AuditView DataContext="{Binding Audit}" />
                    </Grid>
                    <Grid Visibility="{Binding IsSettingsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:SettingsView DataContext="{Binding Settings}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
