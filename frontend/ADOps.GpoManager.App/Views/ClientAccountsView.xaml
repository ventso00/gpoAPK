<UserControl x:Class="ADOps.GpoManager.App.Views.ClientAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <DockPanel>

            <!-- En-tête + filtres -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Comptes clients" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Comptes utilisateurs du domaine collectés lors de la synchronisation, avec leur département, leur état et leur niveau de privilège. La console ADUC et les autres outils d'administration de la machine sont accessibles ici." Style="{StaticResource PageSubtitleStyle}" />

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECHERCHE (compte, nom, courriel)" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" MinWidth="200">
                            <TextBlock Text="DÉPARTEMENT" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Departments}"
                                      SelectedItem="{Binding SelectedDepartment}"
                                      IsEditable="False"
                                      Margin="0,4,0,0"
                                      Style="{StaticResource ComboBoxStyle}" />
                        </StackPanel>

                        <CheckBox Grid.Column="2" Margin="16,22,0,0" IsChecked="{Binding OnlyStandardAccounts}" Style="{StaticResource OptionStyle}">
                            <TextBlock Text="Standards uniquement" Style="{StaticResource BodyStyle}" />
                        </CheckBox>

                        <Button Grid.Column="3" Content="Rafraîchir" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="12,16,0,0" />
                        <Button Grid.Column="4" Content="Ouvrir ADUC" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenActiveDirectoryUsersCommand}" Margin="8,16,0,0" />
                    </Grid>
                </Border>

                <!-- Message d'état -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- Liste des comptes clients -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="{Binding AccountCountText}" Style="{StaticResource FieldLabelStyle}" Margin="16,14,16,0" />
                        <DataGrid ItemsSource="{Binding Accounts}"
                                  SelectedItem="{Binding SelectedAccount}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Compte" Binding="{Binding SamAccountName}" Width="1.2*" />
                                <DataGridTextColumn Header="Nom complet" Binding="{Binding DisplayName, TargetNullValue='—'}" Width="1.6*" />
                                <DataGridTextColumn Header="Département" Binding="{Binding Department, TargetNullValue='Non classé'}" Width="1.2*" />
                                <DataGridTextColumn Header="OU" Binding="{Binding OuName, TargetNullValue='—'}" Width="1.4*" />
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="1.1*" />
                                <DataGridTextColumn Header="Courriel" Binding="{Binding Email, TargetNullValue='—'}" Width="1.6*" />
                                <DataGridCheckBoxColumn Header="Activé" Binding="{Binding Enabled}" Width="0.7*" />
                                <DataGridTextColumn Header="Dernière ouverture de session" Binding="{Binding LastLogonUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Jamais'}" Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource HintStyle}" Margin="16,8,16,12" TextWrapping="Wrap"
                                   Text="Les données proviennent de la dernière synchronisation. Utilisez « Synchroniser » dans la barre supérieure pour les mettre à jour. Le filtre « Standards uniquement » exclut les comptes d'administration, qui ne doivent pas recevoir les stratégies destinées aux utilisateurs standards." />
                    </StackPanel>
                </Border>

                <!-- Outils d'administration de la machine -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="OUTILS D'ADMINISTRATION" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding AdministrativeToolsFolderText}" Style="{StaticResource HintStyle}" />

                            <Button Content="Ouvrir le dossier des outils" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenAdministrativeToolsFolderCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />

                            <TextBlock Text="CONSOLES DISPONIBLES" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
                            <ItemsControl ItemsSource="{Binding AdminTools}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepCardStyle}" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Descriptor.DisplayName}" Style="{StaticResource BodyStrongStyle}" />
                                                    <TextBlock Text="{Binding Descriptor.Description}" Style="{StaticResource HintStyle}" />
                                                    <TextBlock Text="{Binding Path, TargetNullValue='Non installé sur cette machine'}" Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Ouvrir"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.LaunchToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="RACCOURCIS INSTALLÉS" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Raccourcis présents dans le dossier « Outils d'administration » de cette machine." />
                            <ItemsControl ItemsSource="{Binding InstalledShortcuts}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,4"
                                                Padding="10,5"
                                                Style="{StaticResource NavButtonStyle}"
                                                Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</UserControl>
