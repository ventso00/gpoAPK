<UserControl x:Class="ADOps.GpoManager.App.Views.GpoAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ En-tête + fil d'étapes ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Déployer une stratégie de groupe" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding StepHint}" Style="{StaticResource PageSubtitleStyle}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding GoToStepCommand}" CommandParameter="1" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="1" Style="{StaticResource BodyStrongStyle}" />
                            </Border>
                            <TextBlock Text="Cibles" Style="{StaticResource BodyStrongStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="Postes et comptes clients" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding GoToStepCommand}" CommandParameter="2" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="2" Style="{StaticResource BodyStrongStyle}" />
                            </Border>
                            <TextBlock Text="Stratégies" Style="{StaticResource BodyStrongStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="GPO du domaine et catalogue" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding GoToStepCommand}" CommandParameter="3" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="3" Style="{StaticResource BodyStrongStyle}" />
                            </Border>
                            <TextBlock Text="Vérification" Style="{StaticResource BodyStrongStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="Plan et impact" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Command="{Binding GoToStepCommand}" CommandParameter="4" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <StackPanel>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="4" Style="{StaticResource BodyStrongStyle}" />
                            </Border>
                            <TextBlock Text="Exécution" Style="{StaticResource BodyStrongStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="Terminal et résultat" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ============ Contenu de l'étape ============ -->
        <Grid Grid.Row="1" Margin="0,16,0,0">

            <!-- Etape 1 : cibles -->
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Comptes clients -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="18,16,18,0">
                            <TextBlock Text="COMPTES CLIENTS DU DOMAINE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TargetStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TargetSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" MinHeight="36" Padding="10,6"
                                         ToolTip="Rechercher un compte, ou saisir un nom puis « Ajouter »" />
                                <Button Grid.Column="1" Content="Ajouter" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" MinHeight="36"
                                        Command="{Binding AddTargetCommand}" Margin="6,0,0,0" />
                                <Button Grid.Column="2" Content="Tout cocher" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" MinHeight="36"
                                        Command="{Binding SelectAllAccountsCommand}" Margin="6,0,0,0" />
                                <Button Grid.Column="3" Content="Réinitialiser" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" MinHeight="36"
                                        Command="{Binding ResetTargetsCommand}" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Accounts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="18,14,18,18">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                <DataGridTextColumn Header="Compte" Binding="{Binding SamAccountName}" Width="1.1*" />
                                <DataGridTextColumn Header="Nom" Binding="{Binding DisplayName}" Width="1.4*" />
                                <DataGridTextColumn Header="Département" Binding="{Binding Department, TargetNullValue='—'}" Width="1.1*" />
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="0.9*" />
                                <DataGridTemplateColumn Header="" Width="46">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Retirer cette cible"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,3" MinHeight="26"
                                                    Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Postes -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="18,16,18,0">
                            <TextBlock Text="POSTES DU DOMAINE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="Les postes sont ciblés par leur unité d'organisation : une seule liaison de GPO est créée par conteneur." Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                            <Button Content="Tout cocher les postes" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SelectAllComputersCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" MinHeight="32" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Computers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="18,14,18,18">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                <DataGridTextColumn Header="Poste" Binding="{Binding Name}" Width="1.2*" />
                                <DataGridTextColumn Header="Système" Binding="{Binding OperatingSystem, TargetNullValue='—'}" Width="1.6*" />
                                <DataGridTextColumn Header="OU" Binding="{Binding OuName, TargetNullValue='—'}" Width="1.4*" />
                                <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Etape 2 : GPO -->
            <Grid Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="18,16,18,0">
                            <TextBlock Text="STRATÉGIES DISPONIBLES" Style="{StaticResource FieldLabelStyle}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GpoSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                         ToolTip="Rechercher une stratégie" />
                                <Button Grid.Column="1" Content="➕ Ajouter une GPO" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenCreateGpoCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding GpoChoices}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="18,14,18,18">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                <DataGridTextColumn Header="Stratégie" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="Origine" Binding="{Binding OriginText}" Width="1.1*" />
                                <DataGridTextColumn Header="Portée" Binding="{Binding ScopeText}" Width="0.8*" />
                                <DataGridTextColumn Header="Risque" Binding="{Binding RiskText}" Width="0.9*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="À PROPOS" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Les « GPO du domaine » sont déjà présentes dans Active Directory : cochez-les pour les lier à vos cibles. Les « modèles du catalogue » sont des recettes de durcissement ; ils deviennent une vraie GPO lorsqu'ils sont créés sur le domaine." />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="« Ajouter une GPO » crée réellement une stratégie dans le domaine avec vos propres paramètres de registre." />

                        <Border Style="{StaticResource PanelStyle}" Margin="0,14,0,0" Visibility="{Binding ShowCreateGpo, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="NOUVELLE GPO" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="Nom" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewGpoName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                                <TextBlock Text="Description" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewGpoDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                                <TextBlock Text="Clé de registre" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewGpoRegistryKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0"
                                         ToolTip="Ex. : Software\Policies\Microsoft\Windows\System" />
                                <TextBlock Text="Nom de la valeur" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewGpoValueName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                                <TextBlock Text="Type" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <ComboBox ItemsSource="{Binding ValueTypesView}" SelectedItem="{Binding NewGpoValueType}" Style="{StaticResource ComboBoxStyle}" Margin="0,4,0,0" />
                                <TextBlock Text="Valeur" Style="{StaticResource CaptionStyle}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding NewGpoValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Créer dans le domaine" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateGpoCommand}" Padding="14,8" MinHeight="36" Margin="0,0,8,0" />
                                    <Button Content="Annuler" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CloseCreateGpoCommand}" Padding="14,8" MinHeight="36" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Etape 3 : verification -->
            <Grid Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PLAN D'IMPACT" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Style="{StaticResource BodyStrongStyle}" Margin="0,8,0,0" />

                        <Border Style="{StaticResource PanelStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Ce qui va se passer" Style="{StaticResource BodyStrongStyle}" />
                                <TextBlock Style="{StaticResource HintStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="1. Une liaison de GPO est créée par stratégie et par unité d'organisation (New-GPLink)." />
                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                           Text="2. Le filtre de sécurité limite l'application de la stratégie au groupe indiqué et écarte les comptes d'administration." />
                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                           Text="3. Chaque poste ciblé est actualisé (gpupdate /force) puis contrôlé (gpresult). Cette étape exige WinRM sur le poste client." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="OPTIONS" Style="{StaticResource FieldLabelStyle}" />

                        <CheckBox IsChecked="{Binding ApplySecurityFilter}" Style="{StaticResource OptionStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Filtrage de sécurité" Style="{StaticResource BodyStrongStyle}" />
                                <TextBlock Text="La stratégie ne s'applique qu'au groupe ci-dessous ; les comptes d'administration en sont exclus." Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="GROUPE AUTORISÉ (DN)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding SecurityGroupDn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0"
                                 ToolTip="Ex. : CN=Utilisateurs Standards,OU=Groupes,DC=sarytany,DC=local" />

                        <CheckBox IsChecked="{Binding RefreshTargets}" Style="{StaticResource OptionStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Actualiser les postes cibles" Style="{StaticResource BodyStrongStyle}" />
                                <TextBlock Text="Lance gpupdate /force sur chaque poste via WinRM, puis relit les GPO appliquées (gpresult)." Style="{StaticResource HintStyle}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Etape 4 : execution -->
            <Grid Visibility="{Binding IsStep4, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource TerminalStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="ConsoleScroll">
                        <ItemsControl ItemsSource="{Binding Console}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" Style="{StaticResource TerminalTextStyle}" Margin="0,1,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Style="{StaticResource BodyStrongStyle}" />
                        <TextBlock Text="{Binding ExecutionStatusText}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />

                        <TextBlock Text="COMPTES CONCERNÉS PAR LA GPO" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"
                                   Visibility="{Binding AppliedAccounts, Converter={StaticResource NullToVisibilityConverter}}" />
                        <DataGrid ItemsSource="{Binding AppliedAccounts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Style="{StaticResource DataGridStyle}"
                                  MaxHeight="240"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="0.6*" />
                                <DataGridTextColumn Header="Compte" Binding="{Binding Name}" Width="1.3*" />
                                <DataGridTextColumn Header="Identifiant" Binding="{Binding Detail}" Width="1.1*" />
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="0.9*" />
                                <DataGridTextColumn Header="DN" Binding="{Binding DistinguishedName}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Barre de navigation ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← Retour" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousStepCommand}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepTitle}" Style="{StaticResource BodyStrongStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Suivant →" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextStepCommand}"
                            Visibility="{Binding IsStep3, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="0,0,10,0" />
                    <Button Content="▶ Exécuter" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ExecuteCommand}"
                            Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
