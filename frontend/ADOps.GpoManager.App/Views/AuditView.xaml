<UserControl x:Class="ADOps.GpoManager.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ADOps.GpoManager.App.Controls"
             xmlns:models="clr-namespace:ADOps.GpoManager.Core.Models;assembly=ADOps.GpoManager.Core"
             FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <DockPanel Margin="{StaticResource PagePadding}">

            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <controls:LucideIcon Icon="History" Width="18" Height="18" Stroke="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Journal d'audit" Style="{StaticResource PageTitleStyle}" Margin="0" />
                        <TextBlock Text="Toutes les opérations du moteur sont conservées localement, même en cas d'échec."
                                   Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,10,0,0"
                           Text="Journal des opérations enregistrées en base SQLite locale : auteur, serveur, domaine, action, cible, états, durée, code d'erreur et identifiant d'opération. Aucun mot de passe n'y est stocké."
                           Style="{StaticResource PageSubtitleStyle}" />

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   Style="{StaticResource BodyStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:LucideIcon Icon="RefreshCw" Width="13" Height="13" />
                                <TextBlock Text="Actualiser" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="0">
                <DataGrid ItemsSource="{Binding Entries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Disabled"
                          RowHeight="NaN"
                          MinRowHeight="40"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <!-- Les colonnes texte reçoivent une troncature + infobulle :
                             sans cela un libellé long est coupé net à haute densité. -->
                        <DataGridTextColumn Header="Horodatage" Binding="{Binding Timestamp}" Width="1.25*" MinWidth="162">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TruncatedCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Timestamp}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.25*" MinWidth="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TruncatedCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Action}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cible" Binding="{Binding Target}" Width="0.75*" MinWidth="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TruncatedCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Target}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Résultat" Width="0.9*" MinWidth="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="999" BorderThickness="1"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Success}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Warning}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Failure}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Width="12" Height="12" VerticalAlignment="Center">
                                                <controls:LucideIcon.Style>
                                                    <Style TargetType="controls:LucideIcon" BasedOn="{StaticResource {x:Type controls:LucideIcon}}">
                                                        <Setter Property="Icon" Value="Info" />
                                                        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Success}">
                                                                <Setter Property="Icon" Value="CircleCheck" />
                                                                <Setter Property="Stroke" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Warning}">
                                                                <Setter Property="Icon" Value="TriangleAlert" />
                                                                <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Failure}">
                                                                <Setter Property="Icon" Value="CircleX" />
                                                                <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:LucideIcon.Style>
                                            </controls:LucideIcon>
                                            <TextBlock Text="{Binding ResultText}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PillTextStyle}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Success}">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Warning}">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Failure}">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Détail" Width="2.7*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3" ToolTip="{Binding TooltipText}">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionStyle}"
                                                   FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </DockPanel>
    </Grid>
</UserControl>
