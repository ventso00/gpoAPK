<Window x:Class="ADOps.GpoManager.App.Views.SessionLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ADOps.GpoManager.App.Controls"
        Title="Session verrouillée"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Border Style="{StaticResource ElevatedCardStyle}" Margin="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Center"
                        Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
                    <controls:LucideIcon Icon="Lock" Width="20" Height="20" Stroke="{DynamicResource WarningBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Session verrouillée" Style="{StaticResource PageTitleStyle}" Margin="0" />
                    <TextBlock Text="Console masquée après une période d'inactivité"
                               Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource BodyStyle}"
                       Text="L'identité employée reste celle de la session Windows courante : aucun identifiant n'est redemandé." />

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="8"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Info" Width="14" Height="14"
                                         Stroke="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock MaxWidth="350"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionStyle}"
                               Text="Pour des raisons de sécurité, l'application se ferme si vous la quittez au lieu de la déverrouiller." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnCloseClick"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="Fermer l'application">
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Icon="LogOut" Width="13" Height="13" />
                        <TextBlock Text="Fermer l'application" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnUnlockClick"
                        IsDefault="True"
                        AutomationProperties.Name="Déverrouiller la session">
                    <StackPanel Orientation="Horizontal">
                        <controls:LucideIcon Icon="KeyRound" Width="13" Height="13" />
                        <TextBlock Text="Déverrouiller" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
