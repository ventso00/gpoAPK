<UserControl x:Class="ADOps.GpoManager.App.Views.ComputerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ADOps.GpoManager.Core.Models;assembly=ADOps.GpoManager.Core">
    <Grid Margin="24">
        <DockPanel>

            <!-- En-tête : identité de la machine -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Fiche ordinateur" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Computer.Name, FallbackValue=—}" Style="{StaticResource PageSubtitleStyle}" FontSize="16" />

                <!-- Message d'état explicite -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <TabControl Margin="0,12,0,0" Style="{StaticResource TabControlStyle}">

                <!-- ===== 1. Vue générale ===== -->
                <TabItem Header="Vue générale" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="IDENTITÉ (AD DS)" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Computer.Name}" Style="{StaticResource BodyStrongStyle}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DistinguishedName" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Computer.DistinguishedName}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OU" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Computer.OuName, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Département" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Computer.DepartmentName, TargetNullValue='Non classé'}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Système d'exploitation" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Computer.OperatingSystem, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Version du système" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Computer.OperatingSystemVersion, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Compte activé" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Computer.Enabled, Converter={StaticResource BooleanToYesNoConverter}}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Dernière ouverture de session" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Computer.LastLogonUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Jamais'}" Style="{StaticResource BodyStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 2. GPO prévues ===== -->
                <TabItem Header="GPO prévues" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="STRATÉGIES ATTENDUES (LIENS DE L'OU ET DU DOMAINE)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="Calculées à partir des liens lus dans AD DS lors de la dernière synchronisation. L'héritage des OU parentes n'est pas estimé : il sera précisé dans une prochaine version." Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding ExpectedGpos}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StepCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding GpoId}" Style="{StaticResource BodyStyle}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Order, StringFormat='Ordre {0}'}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding IsEnabled, Converter={StaticResource BooleanToYesNoConverter}, StringFormat='Actif : {0}'}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="3" Text="{Binding TargetType}" Style="{StaticResource CaptionStyle}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 3. Résultat GPO (RSoP) ===== -->
                <TabItem Header="Résultat GPO (RSoP)" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <TextBlock Text="RÉSULTAT EFFECTIF (gpresult)" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding RsopStatusText}" Style="{StaticResource BodyStrongStyle}" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,0">
                                                <Run Text="Rapport du " /><Run Text="{Binding RsopDateText}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding RsopSourceText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Content="Actualiser le rapport" Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding RefreshRsopCommand}" Margin="16,0,0,0" VerticalAlignment="Top" />
                                    </StackPanel>
                                    <TextBlock Text="Le rapport est obtenu en exécutant gpresult sur le poste lui-même, via WinRM. S'il ne peut être obtenu, l'erreur est expliquée — le résultat n'est jamais supposé." Style="{StaticResource HintStyle}" Margin="0,10,0,0" />

                                    <TextBlock Text="GPO APPLIQUÉES SELON LE RAPPORT" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0" />
                                    <ItemsControl ItemsSource="{Binding AppliedGpos}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StepCardStyle}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyStyle}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 4. Historique des déploiements ===== -->
                <TabItem Header="Historique des déploiements" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="HISTORIQUE DE CET ORDINATEUR" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="Opérations auditées concernant cet ordinateur. Les déploiements de stratégies (assistant en 6 étapes) arrivent avec la prochaine étape du projet : ils seront tracés ici, par ordinateur, avec leur résultat." Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding History}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ResultText}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStrongStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Success}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Warning}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Result}" Value="{x:Static models:AuditResult.Failure}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Action}" Style="{StaticResource CaptionStyle}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Style="{StaticResource CaptionStyle}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 5. Diagnostic ===== -->
                <TabItem Header="Diagnostic" Style="{StaticResource TabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="DISPONIBILITÉ" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="État" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Computer.AvailabilityText}" Style="{StaticResource BodyStrongStyle}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Méthode de test" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Computer.AvailabilityMethod}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Adresse IP (DNS)" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Computer.DnsIpAddress, TargetNullValue='Non résolu'}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="WinRM" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Computer.WinRmAvailable, Converter={StaticResource BooleanToYesNoConverter}}" Style="{StaticResource BodyStyle}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Dernière vérification" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Computer.LastCheckedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Jamais'}" Style="{StaticResource BodyStyle}" />
                                    </Grid>

                                    <TextBlock Text="ERREUR DE DIAGNOSTIC" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"
                                               Visibility="{Binding Computer.HealthError, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Computer.HealthError}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding Computer.HealthError, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <TextBlock Margin="0,16,0,0" Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                               Text="Un ping n'est pas utilisé comme preuve : ICMP est souvent bloqué et un échec de ping ne prouve pas qu'une machine est éteinte. L'état repose sur le DNS et WinRM (Test-WSMan), avec la méthode employée affichée explicitement." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

        </DockPanel>
    </Grid>
</UserControl>