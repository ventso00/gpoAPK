<UserControl x:Class="ADOps.GpoManager.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <DockPanel>

            <!-- ===== En-tête : cible, domaine détecté, barre d'actions ===== -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Diagnostic &amp; Réparation" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Diagnostic intelligent de l'infrastructure (DNS/SRV, WinRM, RSAT, authentification, GPO), causes racines isolées, corrections proposées avec confirmation explicite et post-vérification."
                           Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />

                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="CONTRÔLEUR CIBLE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TargetController}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="ADRESSE RÉSOLUE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TargetIp}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                            <TextBlock Text="DOMAINE DÉTECTÉ" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding DetectedDomain}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="MODE / DERNIER DIAGNOSTIC" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastRunText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="Diagnostiquer tout" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DiagnoseAllCommand}" Margin="0,0,8,0" />
                                <Button Content="Réparer les problèmes détectés" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BuildRepairPlanCommand}" Margin="0,0,8,0" />
                                <Button Content="Re-tester la connexion" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RetestCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsDryRun}" Content="Mode diagnostic (simulation — aucune modification système)" Style="{StaticResource OptionStyle}" />
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="6" Margin="16,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                <StackPanel>

                    <!-- ===== Grille d'état des services ===== -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="ÉTAT DES SERVICES" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="Contrôles exécutés en séquence logique : connectivité, DNS/SRV, modules RSAT, WinRM distant, authentification, accès GPO." Style="{StaticResource HintStyle}" Margin="0,2,0,10" />
                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="252" Margin="0,0,10,10" CornerRadius="8" Padding="12"
                                                Background="{Binding Status, Converter={StaticResource DiagStatusBrush}}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" MinHeight="34" />
                                                <TextBlock Text="{Binding Status, Converter={StaticResource DiagStatusText}}"
                                                           Style="{StaticResource BodyStrongStyle}"
                                                           Foreground="{Binding Status, Converter={StaticResource DiagStatusForeground}}"
                                                           Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== Détail des contrôles ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="DÉTAIL DES CONTRÔLES" Style="{StaticResource FieldLabelStyle}" />
                            <DataGrid ItemsSource="{Binding Checks}"
                                      SelectedItem="{Binding SelectedCheck}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Contrôle" Binding="{Binding Name}" Width="2.4*" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding Status, Converter={StaticResource DiagStatusText}}" Width="0.9*" />
                                    <DataGridTextColumn Header="Code d'erreur" Binding="{Binding ErrorCode, TargetNullValue='—'}" Width="1.3*" />
                                    <DataGridTextColumn Header="Durée" Binding="{Binding Duration.TotalMilliseconds, StringFormat='{}{0:0} ms'}" Width="0.8*" />
                                    <DataGridCheckBoxColumn Header="Élévation requise" Binding="{Binding RequiresElevation}" Width="0.9*" />
                                    <DataGridCheckBoxColumn Header="Auto-correction possible" Binding="{Binding CanAutoFix}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Visibility="{Binding SelectedCheck, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCheck.Name}" Style="{StaticResource BodyStrongStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedCheck.Details}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="CORRECTIFS SUGGÉRÉS" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0" />
                                    <ItemsControl ItemsSource="{Binding SelectedCheck.SuggestedFixes}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Plan de remédiation (aperçu avant application) ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"
                            Visibility="{Binding ShowPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="PLAN DE RÉPARATION — APERÇU AVANT APPLICATION" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding PlanHeaderText}" Style="{StaticResource HintStyle}" Margin="0,2,0,10" />
                            <ItemsControl ItemsSource="{Binding PlanItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Action.Title}" Style="{StaticResource BodyStrongStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Action.Description}" Style="{StaticResource HintStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CheckName}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Top" Margin="10,0,0,0" Padding="8,4" CornerRadius="4"
                                                        Background="{DynamicResource InputBackgroundBrush}">
                                                    <TextBlock Text="{Binding Action.Risk, Converter={StaticResource RiskText}}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxWidth="180" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Appliquer les corrections cochées"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExecutePlanCommand}"
                                        Margin="0,0,8,0" />
                                <TextBlock Text="Chaque application est journalisée (sans aucun secret) et suivie d'une post-vérification automatique."
                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Résultats des corrections ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"
                            Visibility="{Binding ShowResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="RÉSULTAT DES CORRECTIONS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ResultsHeaderText}" Style="{StaticResource HintStyle}" Margin="0,2,0,10" />
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="●" FontSize="16" VerticalAlignment="Top" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Error}" Style="{StaticResource HintStyle}"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding PostCheckStatus}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
