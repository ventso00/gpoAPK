<UserControl x:Class="ADOps.GpoManager.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ADOps.GpoManager.Core.Models;assembly=ADOps.GpoManager.Core">
    <Grid Margin="24">
        <DockPanel>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Catalogue de stratégies" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Modèles de stratégies validés (JSON versionnés). Un modèle n'est pas une GPO : il ne devient une GPO qu'après création explicite sur le domaine." Style="{StaticResource PageSubtitleStyle}" />

                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECHERCHE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CatalogVersion}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,4,6" />
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Liste des modèles -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <ListBox ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             Margin="12"
                             Style="{StaticResource ListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongStyle}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                                            <Run Text="{Binding Category}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Scope}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,2"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                    <Setter Property="Text" Value="{Binding SupportStatus, Converter={StaticResource TemplateSupportToStringConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SupportStatus}" Value="{x:Static models:TemplateSupportStatus.Available}">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SupportStatus}" Value="{x:Static models:TemplateSupportStatus.MissingPrerequisite}">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Détail du modèle -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTemplate}">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" FontSize="20" />
                            <TextBlock Text="{Binding Category, StringFormat='Catégorie : {}{0}'}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />

                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" Margin="0,12,0,0" />

                            <TextBlock Text="EFFET ATTENDU" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding ExpectedEffect}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}" Margin="0,4,0,0" />

                            <TextBlock Text="RISQUE" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />

                            <TextBlock Text="PARAMÈTRES À RENSEIGNER" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyStrongStyle}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}">
                                                        <Run Text="{Binding Type}" />
                                                        <Run Text="{Binding IsRequired, StringFormat=' (requis : {}{0})'}" />
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding EnumValues, StringFormat='Valeurs : {0}'}" Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"
                                                           Visibility="{Binding EnumValues, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="PRÉREQUIS" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <ItemsControl ItemsSource="{Binding Requirements}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,4">
                                            <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="AVERTISSEMENTS" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0"
                                       Visibility="{Binding Warnings, Converter={StaticResource NullToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0"
                                          Visibility="{Binding Warnings, Converter={StaticResource NullToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyStyle}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4">
                                            <Run Text="⚠ " /><Run Text="{Binding Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SupportNote}" TextWrapping="Wrap" Style="{StaticResource HintStyle}" Margin="0,14,0,0"
                                       Visibility="{Binding SupportNote, Converter={StaticResource NullToVisibilityConverter}}" />

                            <Border Margin="0,14,0,0" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="CRÉATION ET APPLICATION DE LA GPO" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyStyle}" Margin="0,6,0,0">
                                        <Run Text="Crée réellement la GPO sur le domaine (New-GPO + Set-GPRegistryValue) et la lie aux OU cibles (New-GPLink), en exécutant le script PowerShell consolidé de backend/gpo/gpo_catalog.json. L'opération est auditée." />
                                    </TextBlock>
                                    <Button Content="Créer et appliquer cette GPO"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding CreateAndApplyCommand}"
                                            CommandParameter="{Binding SelectedTemplate}"
                                            Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Statut -->
                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</UserControl>