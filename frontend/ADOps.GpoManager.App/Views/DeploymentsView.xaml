<UserControl x:Class="ADOps.GpoManager.App.Views.DeploymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <DockPanel>

            <!-- En-tête -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Déploiement de GPO" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Sélection multiple de GPO, ciblage sur les unités d'organisation, rapport d'impact en temps réel, puis validation et application (New-GPLink)." Style="{StaticResource PageSubtitleStyle}" />

                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                <StackPanel>

                    <!-- ===== Étape 1 : sélection des GPO ===== -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="1 · SÉLECTIONNER LES GPO (SÉLECTION MULTIPLE)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Gpos.Count, StringFormat='{}{0} GPO(s) disponible(s) dans le domaine'}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                                    <Button Content="Tout cocher" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SelectAllGposCommand}" Margin="0,0,8,0" />
                                    <Button Content="Tout décocher" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ClearGposCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Gpos}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Sélection" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
                                    <DataGridTextColumn Header="Nom de la GPO" Binding="{Binding DisplayName}" Width="2.4*" />
                                    <DataGridTextColumn Header="Statut" Binding="{Binding StatusText}" Width="1.8*" />
                                    <DataGridTextColumn Header="Identifiant (GUID)" Binding="{Binding GpoId}" Width="2.6*" />
                                    <DataGridTextColumn Header="Modifiée le" Binding="{Binding ModificationTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Étape 2 : ciblage des OU ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="2 · SÉLECTIONNER LES UNITÉS D'ORGANISATION CIBLES (DÉPARTEMENTS)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Targets.Count, StringFormat='{}{0} OU(s) disponible(s) — les départements sont matérialisés par leurs OU'}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0">
                                    <Button Content="Tout cocher" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SelectAllTargetsCommand}" Margin="0,0,8,0" />
                                    <Button Content="Tout décocher" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ClearTargetsCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Targets}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Sélection" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
                                    <DataGridTextColumn Header="Unité d'organisation" Binding="{Binding Name}" Width="1.8*" />
                                    <DataGridTextColumn Header="Département (mapping)" Binding="{Binding DepartmentName, TargetNullValue='Non classé'}" Width="1.6*" />
                                    <DataGridTextColumn Header="Ordinateurs" Binding="{Binding ComputerCount, StringFormat='{}{0}'}" Width="1*" />
                                    <DataGridTextColumn Header="DistinguishedName" Binding="{Binding DistinguishedName}" Width="3.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Étape 3 : rapport d'impact (temps réel) ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="3 · RAPPORT D'IMPACT — UTILISATEURS, ORDINATEURS ET UNITÉS CIBLÉS (TEMPS RÉEL)" Style="{StaticResource FieldLabelStyle}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource StepCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="LIENS PRÉVUS" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding TargetCountText}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource StepCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="UTILISATEURS IMPACTÉS" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding AffectedUsersText}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource StepCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ORDINATEURS IMPACTÉS" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding AffectedComputersText}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding ImpactSummaryText}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <!-- Détail par GPO × OU -->
                            <DataGrid ItemsSource="{Binding ImpactEntries}"
                                      SelectedItem="{Binding SelectedImpactEntry}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="2*" />
                                    <DataGridTextColumn Header="OU cible" Binding="{Binding TargetOuName}" Width="1.6*" />
                                    <DataGridTextColumn Header="Utilisateurs ciblés" Binding="{Binding AffectedUserCount, StringFormat='{}{0}'}" Width="1.2*" />
                                    <DataGridTextColumn Header="Ordinateurs ciblés" Binding="{Binding AffectedComputerCount, StringFormat='{}{0}'}" Width="1.2*" />
                                    <DataGridCheckBoxColumn Header="Déjà liée" Binding="{Binding AlreadyLinked}" Width="0.9*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Détail de l'impact sélectionné : noms des utilisateurs et ordinateurs -->
                            <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Visibility="{Binding SelectedImpactEntry, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}">
                                        <Run Text="DÉTAIL : " /><Run Text="{Binding SelectedImpactEntry.GpoName}" />
                                        <Run Text=" → " /><Run Text="{Binding SelectedImpactEntry.TargetOuName}" />
                                    </TextBlock>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="UTILISATEURS CIBLÉS" Style="{StaticResource CaptionStyle}" />
                                            <ItemsControl ItemsSource="{Binding SelectedImpactEntry.AffectedUsers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,2">
                                                            <Run Text="{Binding DisplayName, FallbackValue=—}" />
                                                            <Run Text=" (" /><Run Text="{Binding SamAccountName}" /><Run Text=")" />
                                                            <Run Text="{Binding Department, StringFormat=' — {0}', TargetNullValue=''}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Aucun utilisateur dans le sous-arbre de cette OU."
                                                       Margin="0,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImpactEntry.AffectedUsers.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="ORDINATEURS CIBLÉS" Style="{StaticResource CaptionStyle}" />
                                            <ItemsControl ItemsSource="{Binding SelectedImpactEntry.AffectedComputers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,0,0,2">
                                                            <Run Text="{Binding Name}" />
                                                            <Run Text="{Binding OperatingSystem, StringFormat=' — {0}', TargetNullValue=''}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Aucun ordinateur dans le sous-arbre de cette OU."
                                                       Margin="0,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedImpactEntry.AffectedComputers.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Étape 4 : validation et déploiement ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="4 · VALIDER ET DÉPLOYER" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="La validation calcule le plan exact (liens, cibles, impact) ; le déploiement applique chaque lien via New-GPLink sur le domaine, après confirmation. Chaque opération est auditée." Style="{StaticResource HintStyle}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Valider et déployer les GPO sélectionnées"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding DeployCommand}"
                                        IsEnabled="{Binding HasValidPlan}"
                                        Margin="0,0,8,0" />
                                <Button Content="Voir les GPO du domaine" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenGpoListCommand}" Margin="0,0,8,0" />
                                <Button Content="Voir le parc" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenParcCommand}" />
                            </StackPanel>

                            <!-- Résultats du dernier déploiement -->
                            <Border Margin="0,12,0,0" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Visibility="{Binding ShowResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="RÉSULTAT DU DÉPLOIEMENT" Style="{StaticResource FieldLabelStyle}" />
                                    <ItemsControl ItemsSource="{Binding DeploymentResults}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StepCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="●"
                                                                   FontSize="16"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   Foreground="{DynamicResource SuccessBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Error}" Style="{StaticResource HintStyle}"
                                                                       Foreground="{DynamicResource DangerBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Liens existants sur les OU sélectionnées ===== -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="LIENS DE GPO EXISTANTS SUR LES OU SÉLECTIONNÉES" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="Lus depuis AD DS (cache de synchronisation). Un lien peut être supprimé (Remove-GPLink) — la suppression est auditée." Style="{StaticResource HintStyle}" Margin="0,4,0,0" />

                            <DataGrid ItemsSource="{Binding SelectedOuLinks}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GPO" Binding="{Binding DisplayName}" Width="2.2*" />
                                    <DataGridTextColumn Header="Identifiant (GUID)" Binding="{Binding GpoId}" Width="2*" />
                                    <DataGridTextColumn Header="Cible (OU / domaine)" Binding="{Binding TargetDistinguishedName}" Width="3*" />
                                    <DataGridTextColumn Header="Ordre" Binding="{Binding Order, StringFormat='{}{0}'}" Width="0.8*" />
                                    <DataGridCheckBoxColumn Header="Actif" Binding="{Binding IsEnabled}" Width="0.7*" />
                                    <DataGridTemplateColumn Header="Action" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Supprimer le lien"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Command="{Binding DataContext.UnlinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</UserControl>
