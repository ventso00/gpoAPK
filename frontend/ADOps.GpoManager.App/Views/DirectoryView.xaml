<UserControl x:Class="ADOps.GpoManager.App.Views.DirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ADOps.GpoManager.Core.Models;assembly=ADOps.GpoManager.Core"
             xmlns:vm="clr-namespace:ADOps.GpoManager.App.ViewModels">
    <UserControl.Resources>
        <!-- Nœud OU : nom + compteurs du sous-arbre -->
        <HierarchicalDataTemplate DataType="{x:Type vm:OuNode}" ItemsSource="{Binding Items}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SubtreeText}" Style="{StaticResource CaptionStyle}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Feuille utilisateur -->
        <DataTemplate DataType="{x:Type models:UserInfo}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource BodyStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding SamAccountName}" Style="{StaticResource CaptionStyle}"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <DockPanel>

            <!-- En-tête -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Annuaire Active Directory" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Structure organisationnelle du domaine (unités d'organisation et utilisateurs rattachés), lue dans AD DS." Style="{StaticResource PageSubtitleStyle}" />

                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Arborescence ===== -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="STRUCTURE DU DOMAINE" Style="{StaticResource FieldLabelStyle}" Margin="8,8,8,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Connection.Current.DomainFqdn, FallbackValue=—}"
                                   Style="{StaticResource BodyStrongStyle}" Margin="8,4,8,8" />
                        <TreeView ItemsSource="{Binding Root.Children}" Margin="0,0,0,0"
                                  BorderThickness="0" Background="Transparent"
                                  HorizontalContentAlignment="Stretch" />
                    </DockPanel>
                </Border>

                <!-- ===== Détails ===== -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Fiche de l'OU sélectionnée -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="UNITÉ D'ORGANISATION SÉLECTIONNÉE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedOu.Name, FallbackValue=—}" Style="{StaticResource PageSubtitleStyle}" FontSize="16" Margin="0,6,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DistinguishedName" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OuDetailsText}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Utilisateurs directs" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserCountText}" Style="{StaticResource BodyStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sous-arbre" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOu.SubtreeText, FallbackValue=—}" Style="{StaticResource BodyStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ordinateurs (OU directe)" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedOu.ComputerCount, StringFormat='{}{0} ordinateur(s)'}" Style="{StaticResource BodyStyle}" />
                            </Grid>

                            <TextBlock Text="GPO LIÉES À CETTE OU" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                            <ItemsControl ItemsSource="{Binding OuGpoLinks}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StepCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyStrongStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding GpoId}" ToolTip="{Binding GpoId}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Order, StringFormat='Ordre {0}'}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BooleanToYesNoConverter}, StringFormat='Actif : {0}'}" Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recherche d'utilisateurs -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RECHERCHE (nom, login, e-mail, département)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding UserCountText}" Style="{StaticResource BodyStrongStyle}"
                                       VerticalAlignment="Bottom" Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Utilisateurs de l'OU + fiche détaillée -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                            <StackPanel>
                                <DataGrid ItemsSource="{Binding OuUsersView}"
                                          SelectedItem="{Binding SelectedUser}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          Style="{StaticResource DataGridStyle}"
                                          Margin="0,0,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nom affiché" Binding="{Binding DisplayName, TargetNullValue='—'}" Width="1.6*" />
                                        <DataGridTextColumn Header="Login" Binding="{Binding SamAccountName}" Width="1.4*" />
                                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email, TargetNullValue='—'}" Width="1.8*" />
                                        <DataGridTextColumn Header="Département" Binding="{Binding Department, TargetNullValue='—'}" Width="1.4*" />
                                        <DataGridTextColumn Header="Fonction" Binding="{Binding Title, TargetNullValue='—'}" Width="1.4*" />
                                        <DataGridCheckBoxColumn Header="Activé" Binding="{Binding Enabled}" Width="0.7*" />
                                        <DataGridTextColumn Header="Dernière ouverture" Binding="{Binding LastLogonUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Jamais'}" Width="1.5*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Fiche utilisateur -->
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="FICHE UTILISATEUR" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedUser.DisplayText, FallbackValue=Sélectionnez un utilisateur}"
                                           Style="{StaticResource BodyStrongStyle}" FontSize="15" Margin="0,8,0,0" />

                                <Grid Margin="0,12,0,0" Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUser.DisplayName, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Login" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedUser.SamAccountName}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Prénom" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUser.GivenName, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nom de famille" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedUser.Surname, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="E-mail" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedUser.Email, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Département" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedUser.Department, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Fonction" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedUser.Title, TargetNullValue='—'}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Compte" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedUser.StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedUser.Enabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Dernière ouverture" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedUser.LastLogonUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Jamais'}" Style="{StaticResource BodyStyle}" />

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="DistinguishedName" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedUser.DistinguishedName}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

        </DockPanel>
    </Grid>
</UserControl>
