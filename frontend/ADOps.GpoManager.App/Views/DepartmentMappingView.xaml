<UserControl x:Class="ADOps.GpoManager.App.Views.DepartmentMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <DockPanel>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Mapping des départements" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Associez des départements aux unités d'organisation de votre annuaire. Cette correspondance est stockée dans l'application : AD DS n'est jamais créé, renommé ou modifié par l'outil." Style="{StaticResource PageSubtitleStyle}" />

                <!-- Message d'état explicite -->
                <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Unités d'organisation et leur affectation actuelle -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0" Padding="0">
                    <StackPanel>
                        <TextBlock Text="UNITÉS D'ORGANISATION (LUES DANS AD DS)" Style="{StaticResource FieldLabelStyle}" Margin="16,14,16,0" />
                        <TextBlock Text="Sélectionnez une OU, puis saisissez le nom du département à droite." Style="{StaticResource HintStyle}" Margin="16,4,16,0" />
                        <ListBox ItemsSource="{Binding OrganizationalUnits}"
                                 SelectedItem="{Binding SelectedOu}"
                                 Margin="16,10,16,16"
                                 Style="{StaticResource ListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongStyle}" />
                                            <TextBlock Text="{Binding DistinguishedName}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ComputerCount, StringFormat='{}{0} PC'}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MappingText}" Style="{StaticResource CaptionStyle}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Association : saisie + départements existants -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ASSOCIER UN DÉPARTEMENT" Style="{StaticResource FieldLabelStyle}" />

                        <TextBlock Text="OU SÉLECTIONNÉE" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding SelectedOu.Name, TargetNullValue='Aucune OU sélectionnée'}" Style="{StaticResource BodyStrongStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedOu.DistinguishedName, TargetNullValue=''}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                        <TextBlock Text="NOM DU DÉPARTEMENT" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="Ex. : Informatique, Direction, Commercial — le nom est libre et stocké localement." Style="{StaticResource HintStyle}" />

                        <Button Content="Associer le département à l'OU" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AssignDepartmentCommand}" Margin="0,14,0,0" />

                        <TextBlock Text="DÉPARTEMENTS EXISTANTS" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,0" />
                        <ItemsControl ItemsSource="{Binding Departments}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StepCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DepartmentName}" Style="{StaticResource BodyStrongStyle}" />
                                                <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,2,0,0">
                                                    <Run Text="{Binding ComputerCount, StringFormat='{}{0} ordinateur(s)'}" />
                                                    <Run Text=" — OU : " />
                                                    <Run Text="{Binding OuDistinguishedName, TargetNullValue='(aucune OU)'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Retirer" Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="8,0,0,0" Padding="8,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</UserControl>